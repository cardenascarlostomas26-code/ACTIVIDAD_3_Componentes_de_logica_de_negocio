        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    %% Agregado Contrato\n    namespace Aggregate_Contrato {\n        class Contrato {\n            &lt;&lt;Aggregate Root&gt;&gt;\n        }\n        class ContratoAdicional {\n            &lt;&lt;Entity&gt;&gt;\n        }\n        class Presupuesto {\n            &lt;&lt;Value Object&gt;&gt;\n        }\n    }\n\n    %% Agregado Proveedor\n    namespace Aggregate_Proveedor {\n        class Proveedor {\n            &lt;&lt;Aggregate Root&gt;&gt;\n        }\n        class DatosContacto {\n            &lt;&lt;Value Object&gt;&gt;\n        }\n        class PeriodoConfirmacion {\n            &lt;&lt;Value Object&gt;&gt;\n        }\n    }\n\n    %% Entidades Independientes\n    class Evento {\n        &lt;&lt;Entity&gt;&gt;\n    }\n    class Cliente {\n        &lt;&lt;Entity&gt;&gt;\n    }\n\n    %% Relaciones internas de los agregados\n    Contrato *-- ContratoAdicional \n    Contrato *-- Presupuesto \n    Proveedor *-- DatosContacto \n    Proveedor *-- PeriodoConfirmacion \n    \n    %% Relaciones externas\n    Contrato --&gt; Evento : pertenece a\n    Contrato --&gt; Cliente : firmado por\n    Evento --&gt; Proveedor : asignado a&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="-gm7T8F0NEruyEIJ0jCj-1">
