        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam packageStyle rectangle\nskinparam roundcorner 5\n\npackage \&quot;CAPA DE APLICACIÓN (Etapas 4 y 6)\&quot; #F4FAED {\n    class ConsultarContratoHandler &lt;&lt;Query Handler&gt;&gt; #D5E8D4 {\n        + Handle(query)\n    }\n    class ConsultarProveedoresHandler &lt;&lt;Query Handler&gt;&gt; #D5E8D4 {\n        + Handle(query)\n    }\n    class AgregarServicioExtraHandler &lt;&lt;Command Handler&gt;&gt; #D5E8D4 {\n        + Handle(cmd)\n    }\n    class AprobarCotizacionHandler &lt;&lt;Command Handler&gt;&gt; #D5E8D4 {\n        + Handle(cmd)\n    }\n\n    class ProveedorAppService &lt;&lt;Application Service&gt;&gt; #D5E8D4 {\n        + RegistrarCancelacion()\n    }\n    class ContratoAppService &lt;&lt;Application Service&gt;&gt; #D5E8D4 {\n        + AprobarCotizacion()\n        + AgregarServicioExtra()\n    }\n    class EventoAppService &lt;&lt;Application Service&gt;&gt; #D5E8D4 {\n        + SolicitarCambioNormal()\n    }\n    class AdminAppService &lt;&lt;Application Service&gt;&gt; #D5E8D4 {\n        + AplicarPenalizacion()\n    }\n\n    interface IContratoConsultas &lt;&lt;interface&gt;&gt; #D5E8D4 {\n        + ObtenerContrato()\n    }\n    interface IProveedorConsultas &lt;&lt;interface&gt;&gt; #D5E8D4 {\n        + ListarPorEvento()\n    }\n    interface IDomainEventDispatcher &lt;&lt;interface&gt;&gt; #D5E8D4 {\n        + Despachar(evento)\n    }\n    interface IUnitOfWork &lt;&lt;interface&gt;&gt; #D5E8D4 {\n        + IniciarTransaccion()\n        + Commit()\n        + Rollback()\n    }\n}\n\npackage \&quot;CAPA DE DOMINIO (Etapas 3 y 5)\&quot; #F4F9FC {\n    interface IProveedorRepository &lt;&lt;interface&gt;&gt; #DAE8FC {\n        + ObtenerPorId()\n        + Guardar()\n    }\n    interface IEventoRepository &lt;&lt;interface&gt;&gt; #DAE8FC {\n        + ObtenerPorId()\n        + Guardar()\n    }\n    interface IContratoRepository &lt;&lt;interface&gt;&gt; #DAE8FC {\n        + ObtenerPorId()\n        + Guardar()\n    }\n    class PenalizacionDomainService &lt;&lt;Domain Service&gt;&gt; #DAE8FC {\n        + CalcularMulta()\n        + CancelarEnCascada()\n    }\n\n    class Evento &lt;&lt;Entity&gt;&gt; #DAE8FC {\n        eventoId\n        fechaEvento\n        estado\n        + SolicitarCambioNormal()\n    }\n    class Contrato &lt;&lt;Aggregate Root&gt;&gt; #DAE8FC {\n        contratoId\n        estado\n        anticipoInicial\n        + AprobarCotizacion()\n        + AgregarServicio()\n        + ValidarAnticipo()\n        + TieneSaldoVencido()\n        + CostoTotal()\n    }\n    class Cliente &lt;&lt;Entity&gt;&gt; #DAE8FC {\n        clienteId\n        nombre\n    }\n    class Proveedor &lt;&lt;Aggregate Root&gt;&gt; #DAE8FC {\n        proveedorId\n        estado\n        + CancelarParticipacion()\n        + ExpirarSiSinRespuesta()\n    }\n\n    class ContratoAdicional &lt;&lt;Entity&gt;&gt; #DAE8FC {\n        servicio\n        costo\n    }\n    class Presupuesto &lt;&lt;Value Object&gt;&gt; #DAE8FC {\n        monto\n        moneda\n        + Excede()\n    }\n    class ContratoPrincipal &lt;&lt;Entity&gt;&gt; #DAE8FC {\n        costoBase\n    }\n    class DatosContacto &lt;&lt;Value Object&gt;&gt; #DAE8FC {\n        telefono\n        correo\n    }\n    class PeriodoConfirmacion &lt;&lt;Value Object&gt;&gt; #DAE8FC {\n        dias\n    }\n\n    class CambioFueraDeTiempoException &lt;&lt;Exception&gt;&gt; #DAE8FC\n    class ContratoActivadoEvent &lt;&lt;Domain Event&gt;&gt; #DAE8FC\n    class PresupuestoExcedidoEvent &lt;&lt;Domain Event&gt;&gt; #DAE8FC\n    class PresupuestoExcedidoException &lt;&lt;Exception&gt;&gt; #DAE8FC\n    class ServiciosModificadosEvent &lt;&lt;Domain Event&gt;&gt; #DAE8FC\n    class ProveedorCanceladoEvent &lt;&lt;Domain Event&gt;&gt; #DAE8FC\n    class AdvertenciaGeneradaEvent &lt;&lt;Domain Event&gt;&gt; #DAE8FC\n\n    Contrato *-- \&quot;0..*\&quot; ContratoAdicional\n    Contrato *-- \&quot;1\&quot; Presupuesto\n    Contrato *-- \&quot;1\&quot; ContratoPrincipal\n    Contrato --&gt; Evento : eventoId\n    Contrato --&gt; Cliente : clienteId\n    Proveedor *-- \&quot;1\&quot; DatosContacto\n    Proveedor *-- \&quot;1\&quot; PeriodoConfirmacion\n\n    Contrato ..&gt; ContratoActivadoEvent : emite\n    Contrato ..&gt; PresupuestoExcedidoEvent : emite\n    Contrato ..&gt; PresupuestoExcedidoException : lanza\n    ContratoAdicional ..&gt; CambioFueraDeTiempoException : lanza\n    Evento ..&gt; ServiciosModificadosEvent : emite\n    Proveedor ..&gt; ProveedorCanceladoEvent : emite\n    Proveedor ..&gt; AdvertenciaGeneradaEvent : emite\n}\n\npackage \&quot;CAPA DE INFRAESTRUCTURA (Etapa 5)\&quot; #FFFBF4 {\n    class SqlUnitOfWork &lt;&lt;Unit of Work&gt;&gt; #FFE6CC {\n        + IniciarTransaccion()\n        + Commit()\n        + Rollback()\n    }\n    class ProveedorRepository &lt;&lt;Repository&gt;&gt; #FFE6CC {\n        + ObtenerPorId()\n        + Guardar()\n    }\n    class EventoRepository &lt;&lt;Repository&gt;&gt; #FFE6CC {\n        + ObtenerPorId()\n        + Guardar()\n    }\n    class ContratoRepository &lt;&lt;Repository&gt;&gt; #FFE6CC {\n        + ObtenerPorId()\n        + Guardar()\n    }\n    \n    class ContratoConsultas &lt;&lt;Read Model&gt;&gt; #FFE6CC {\n        + ObtenerContrato()\n    }\n    class ProveedorConsultas &lt;&lt;Read Model&gt;&gt; #FFE6CC {\n        + ListarPorEvento()\n    }\n    class DomainEventDispatcher &lt;&lt;Dispatcher&gt;&gt; #FFE6CC {\n        + Despachar()\n    }\n}\n\n&#39; Implementaciones\nSqlUnitOfWork ..|&gt; IUnitOfWork\nProveedorRepository ..|&gt; IProveedorRepository\nEventoRepository ..|&gt; IEventoRepository\nContratoRepository ..|&gt; IContratoRepository\nContratoConsultas ..|&gt; IContratoConsultas\nProveedorConsultas ..|&gt; IProveedorConsultas\nDomainEventDispatcher ..|&gt; IDomainEventDispatcher\n\n&#39; Dependencias desde Aplicación\nConsultarContratoHandler ..&gt; IContratoConsultas\nConsultarProveedoresHandler ..&gt; IProveedorConsultas\nAgregarServicioExtraHandler --&gt; ContratoAppService\nAprobarCotizacionHandler --&gt; ContratoAppService\n\nProveedorAppService ..&gt; IProveedorConsultas\nProveedorAppService ..&gt; IDomainEventDispatcher\nProveedorAppService ..&gt; IUnitOfWork\n\nContratoAppService ..&gt; IDomainEventDispatcher\nContratoAppService ..&gt; IUnitOfWork\n\nEventoAppService ..&gt; IUnitOfWork\nAdminAppService ..&gt; IUnitOfWork\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="PWGTVjYqpZL_jMq8as9A-647">
